  "narrative": {
    "northStar": "PMat mathematical geometry",
    "overview": "PMat mathematical geometry is the inherited visual anchor: the ULM identity, maroon fields, Plus Jakarta Sans, and luminous white glass connect the public portal and internal workspace. The admin extension uses compact type, pale colored surfaces, and controlled shadows to keep operational content readable.\n\nThis record describes the shipped admin extension and its shared primitives. The public landing and catalog remain the visual authority for the established identity; this documentation does not declare those pages redesigned. Route composition and validation evidence live in the dashboard surface brief.",
    "keyCharacteristics": [
      "Maroon identity with rose, violet, teal, and amber category accents.",
      "Frosted white panels, specular edges, and softly rounded controls.",
      "Strong numeric hierarchy and compact operational typography.",
      "Mathematical glass geometry with restrained hover motion."
    ],
    "rules": [
      {
        "name": "The Inherited Identity Rule",
        "body": "Keep maroon, Plus Jakarta Sans, and the ULM identity recognizable across public and internal surfaces. Scope internal overrides to the admin workspace and its drawer.",
        "section": "colors"
      },
      {
        "name": "The Label Alongside Color Rule",
        "body": "Category colors accompany visible labels, icons, and values; they do not carry meaning alone.",
        "section": "colors"
      },
      {
        "name": "The Readable Glass Rule",
        "body": "Use substantial white fill for data panels. Transparent faces and orbit lines belong to decorative geometry, away from operational text.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the public identity and scope admin styling to the workspace or drawer.",
      "Do pair category colors with text and SVG icons.",
      "Do use one page h1 and h2 headings for titled data sections.",
      "Do keep overflow inside table containers and retain visible keyboard focus.",
      "Do preserve the reduced-motion treatment and label mobile navigation."
    ],
    "donts": [
      "Don't import the public hero display size into compact admin panels.",
      "Don't use decorative geometry as the background of dense data text.",
      "Don't turn the dashboard overview composition into a requirement for every route.",
      "Don't treat compact metadata sizes as the default for body copy."
    ]
  }
}
