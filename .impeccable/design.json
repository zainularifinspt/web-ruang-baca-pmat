  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary Button as implemented in the admin extension.",
      "html": "<button class=\"ds-primary\">Simpan</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:8px 16px;border-radius:10px;font-size:14px;font-weight:500;transition:all .2s ease-out;font-family:\"Plus Jakarta Sans\",sans-serif;border:0;background:var(--primary,#b91c1c);color:var(--primary-foreground,#fff)}.ds-primary:hover{background:color-mix(in srgb,var(--primary,#b91c1c) 90%,transparent);transform:translateY(-2px)}.ds-primary:active{transform:scale(.98)}.ds-primary:focus-visible{outline:3px solid #a55dd4;outline-offset:3px}.ds-primary:disabled{opacity:.5;pointer-events:none}"
    },
